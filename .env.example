# Betfair Exchange API: read-only price snapshots. Nothing in this project places bets.
# Copy this file to .env and fill in .env only. Git ignores .env (see .gitignore).
# Your password never goes in here: `python -m punting.betfair login` asks for it,
# sends it once to Betfair, and keeps only the session token in data/private/ (also ignored).

# The Delayed application key (version "1.0-Delay") from the API-NG account visualiser.
BETFAIR_APP_KEY=

# Optional: saves typing your username at each login.
BETFAIR_USERNAME=
